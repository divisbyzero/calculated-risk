% calculatedrisk.sty -- typesets a Calculated Risk game file as a printable document.
%
% The web app reads the same .tex file directly. Commands provided:
%   \gametitle{...}                        (preamble)
%   \begin{category}{Name} ... \end{category}
%   \begin{clue} ... \response ... \end{clue}
%   \begin{clue} ... \response ... \solution ... \end{clue}   (worked solution)
%   \begin{clue}[doubledown] ... \response ... \end{clue}
%     (the Double Down is for the game only; the PDF doesn't show it)
%   \begin{clue}[write] ... or \begin{clue}[say] ...
%     (tells the players whether to write their response before ringing
%     in or just say it; the game shows it, and the PDF shows it only with
%     the writesay option below. Combine with commas:
%     \begin{clue}[doubledown, write])
%   \begin{final}{Category} ... \response ... \solution ... \end{final}
%   \begin{final}[write]{Category} ...   (same write/say option)
%   \includegraphics[width=...]{file.png}  anywhere in a clue,
%     response or solution. Use PNG or JPG so the web game can show it too.
%
% Clue values are assigned by position: 100, 200, 300, ...
%
% By default the PDF shows the board overview, then the clues, responses,
% and worked solutions. Change this with package options, separated by
% commas, e.g. \usepackage[clues, noboard]{calculatedrisk}:
%   clues       the clues only (a study sheet for students)
%   answers     the clues and responses
%   writesay    show each clue's [write]/[say] mark under its value
%               (handy while writing; leave it off for student copies)
%   noboard     leave out the board overview
% (Older option names still work: questions = clues, and solutions and
% board, which are now the default.)
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{calculatedrisk}[2026/11/25 Calculated Risk game files]

%----------------------------------------------------------------------
% Options

\newif\ifcrisk@key       % show responses
\newif\ifcrisk@solutions % show worked solutions
\newif\ifcrisk@writesay  % show [write]/[say] marks
\newif\ifcrisk@board     % show the board overview
\crisk@keytrue\crisk@solutionstrue\crisk@boardtrue % the default
\DeclareOption{clues}{\crisk@keyfalse\crisk@solutionsfalse}
\DeclareOption{answers}{\crisk@keytrue\crisk@solutionsfalse}
\DeclareOption{writesay}{\crisk@writesaytrue}
\DeclareOption{noboard}{\crisk@boardfalse}
% Older names, kept so existing game files still compile.
\DeclareOption{questions}{\crisk@keyfalse\crisk@solutionsfalse}
\DeclareOption{solutions}{\crisk@keytrue\crisk@solutionstrue}
\DeclareOption{nowritesay}{\crisk@writesayfalse}
\DeclareOption{board}{\crisk@boardtrue}
\ProcessOptions\relax

%----------------------------------------------------------------------
% Packages

\RequirePackage{amsmath}
\RequirePackage{amssymb}
\RequirePackage{graphicx} % \includegraphics in clues, responses and solutions
\PassOptionsToPackage{dvipsnames,table,xcdraw}{xcolor} % same as the usual templates
\RequirePackage{xcolor}
\RequirePackage{geometry}
\geometry{letterpaper, margin=1in, headheight=14pt}
\RequirePackage{array}
\RequirePackage{environ}
\RequirePackage{fancyhdr}
\RequirePackage{tcolorbox}
\tcbuselibrary{breakable,skins}

%----------------------------------------------------------------------
% Colors

\definecolor{criskAccent}{HTML}{1B2A6B} % deep navy
\definecolor{criskGold}{HTML}{A87B12}   % muted gold
\definecolor{criskMuted}{HTML}{6B7280}  % gray text
\definecolor{criskRule}{HTML}{D5DAE5}   % light rules
\definecolor{criskSoft}{HTML}{F3F5FA}   % panel background

%----------------------------------------------------------------------
% Title, headers, and footers

\newcommand*{\crisk@title}{Calculated Risk}
\newcommand{\gametitle}[1]{\renewcommand*{\crisk@title}{#1}}

\ifcrisk@solutions
  \newcommand*{\crisk@version}{Answer Key with Solutions}
\else\ifcrisk@key
  \newcommand*{\crisk@version}{Answer Key}
\else
  \newcommand*{\crisk@version}{Clues}
\fi\fi

\newcommand*{\crisk@kicker}{\sffamily\bfseries\footnotesize\color{criskGold}}
\newcommand*{\crisk@meta}{\sffamily\footnotesize\color{criskMuted}}

\pagestyle{fancy}
\fancyhf{}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancyhead[L]{\crisk@meta\crisk@title}
\fancyhead[R]{\crisk@meta\crisk@version}
\fancyfoot[C]{\crisk@meta\thepage}
\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[C]{\crisk@meta\thepage}%
}

\newcommand{\crisk@maketitle}{%
  \thispagestyle{plain}%
  \noindent{\crisk@kicker CALCULATED RISK}\par
  \vspace{6pt}%
  \noindent{\fontsize{24}{29}\selectfont\bfseries\color{criskAccent}\crisk@title\par}%
  \vspace{4pt}%
  \noindent{\large\sffamily\color{criskMuted}\crisk@version}\par
  \vspace{8pt}%
  \noindent{\color{criskAccent}\rule{\linewidth}{1.2pt}}\par
  \vspace{14pt}%
  \ifcrisk@board\crisk@board\fi
}
\AtBeginDocument{\crisk@maketitle}

%----------------------------------------------------------------------
% Board overview (left out with the noboard option)
%
% Each run records the categories in the .aux file; the next run draws
% them as a small board. latexmk reruns automatically.

\newcommand*{\crisk@ncat}{0}
\newcommand*{\crisk@nrows}{0}
\newcommand*{\crisk@finalname}{}
\newcommand{\crisk@auxcat}[2]{%
  \global\@namedef{crisk@cat@#1}{#2}%
  \ifnum#1>\crisk@ncat\relax\xdef\crisk@ncat{#1}\fi
}
\newcommand{\crisk@auxrow}[1]{%
  \ifnum#1>\crisk@nrows\relax\xdef\crisk@nrows{#1}\fi
}
\newcommand{\crisk@auxfinal}[1]{\gdef\crisk@finalname{#1}}

\newcount\crisk@k
\newcount\crisk@r
\newdimen\crisk@colw

\newcommand*{\crisk@headcell}[1]{%
  \cellcolor{criskAccent}\color{white}\sffamily\bfseries\scriptsize
  \rule{0pt}{2.6ex}\@nameuse{crisk@cat@#1}\rule[-1.2ex]{0pt}{0pt}}
\newcommand*{\crisk@valcell}[2]{%
  \cellcolor{criskSoft}\sffamily\footnotesize\color{criskAccent}\the\numexpr100*#2\relax}

\def\crisk@addheads{%
  \xdef\crisk@rows{\unexpanded\expandafter{\crisk@rows}%
    \ifnum\crisk@k>1 &\fi\noexpand\crisk@headcell{\the\crisk@k}}%
  \advance\crisk@k 1
  \ifnum\crisk@k>\crisk@ncat\relax\else\expandafter\crisk@addheads\fi}
\def\crisk@addcells{%
  \xdef\crisk@rows{\unexpanded\expandafter{\crisk@rows}%
    \ifnum\crisk@k>1 &\fi\noexpand\crisk@valcell{\the\crisk@k}{\the\crisk@r}}%
  \advance\crisk@k 1
  \ifnum\crisk@k>\crisk@ncat\relax\else\expandafter\crisk@addcells\fi}

\newcommand{\crisk@board}{%
  \ifnum\crisk@ncat>0
    \gdef\crisk@rows{}%
    \crisk@k=1 \crisk@addheads
    \crisk@r=1
    \loop
      \xdef\crisk@rows{\unexpanded\expandafter{\crisk@rows}\noexpand\\}%
      \crisk@k=1 \crisk@addcells
      \advance\crisk@r 1
    \ifnum\crisk@r<\numexpr\crisk@nrows+1\relax\repeat
    \crisk@colw=\dimexpr(\linewidth-\numexpr\crisk@ncat+1\relax\dimexpr2pt\relax)/\crisk@ncat-2\tabcolsep\relax
    \begingroup
    \centering
    \arrayrulecolor{white}%
    \setlength{\arrayrulewidth}{2pt}%
    \renewcommand{\arraystretch}{1.25}%
    \begin{tabular}{*{\crisk@ncat}{|>{\centering\arraybackslash}m{\crisk@colw}}|}
      \crisk@rows
    \end{tabular}\par
    \ifx\crisk@finalname\@empty\else
      \vspace{6pt}%
      {\crisk@meta Fermat's Last Round:\ \crisk@finalname}\par
    \fi
    \endgroup
    \vspace{10pt}%
  \fi
}

%----------------------------------------------------------------------
% Categories

\newcounter{criskcategory}
\newcounter{criskclue}[criskcategory]

% Start a new page if less than #1 of space is left on this one. (Unlike
% the needspace package, this never encourages a break when there's room.)
\newcommand{\crisk@needspace}[1]{%
  \par
  \ifdim\pagegoal<\maxdimen
    \ifdim\dimexpr\pagegoal-\pagetotal\relax<#1\relax\newpage\fi
  \fi}

\newcommand{\crisk@heading}[2]{% #1 = kicker, #2 = name
  \par\addvspace{22pt}%
  \crisk@needspace{12\baselineskip}%
  \noindent{\crisk@kicker #1}\par\nopagebreak
  \vspace{2pt}%
  \noindent{\Large\bfseries\color{criskAccent}#2}\par\nopagebreak
  \vspace{5pt}%
  \noindent{\color{criskRule}\rule{\linewidth}{0.6pt}}\par\nopagebreak
  \vspace{4pt}%
}

\newenvironment{category}[1]{%
  \stepcounter{criskcategory}%
  \protected@write\@auxout{}{\string\crisk@auxcat{\thecriskcategory}{\unexpanded{#1}}}%
  \crisk@heading{CATEGORY \thecriskcategory}{#1}%
}{\par}

%----------------------------------------------------------------------
% Clues
%
% The clue body is split at \response and \solution. These are only
% markers, so they're defined to do nothing (and not redefined if another
% package already has a \solution command).

\providecommand{\response}{}
\providecommand{\solution}{}

\long\def\crisk@split#1\response#2\solution#3\solution#4\crisk@stop{%
  \crisk@entry{#1}{#2}{#3}{#4}}

\newcommand{\crisk@ifblank}[1]{%
  \if\relax\detokenize{#1}\relax\expandafter\@firstoftwo\else\expandafter\@secondoftwo\fi}

\newcommand*{\crisk@label}[1]{{\sffamily\bfseries\scriptsize\color{criskAccent}#1}}

\newtcolorbox{crisk@answer}{%
  enhanced,
  colback=criskSoft, colframe=criskAccent,
  boxrule=0pt, leftrule=2pt, arc=0pt, outer arc=0pt,
  left=9pt, right=9pt, top=6pt, bottom=6pt,
  before skip=6pt, after skip=2pt,
  segmentation style={draw=criskRule, line width=0.6pt},
  middle=6pt,
  crisk@answerextra,
}
\tcbset{crisk@answerextra/.style={}}
% Fermat's Last Round's box may continue onto the next page (see \crisk@entry).
\newif\ifcrisk@final

\newcommand*{\crisk@valuetext}{}
\newcommand*{\crisk@mode}{}
\let\crisk@auxwrite\relax
\newcommand{\crisk@makevalue}[1]{%
  \ifcrisk@writesay
    \begin{tabular}[t]{@{}r@{}}%
      {\sffamily\bfseries\color{criskAccent}#1}\\[-1pt]%
      \crisk@modetag
    \end{tabular}%
  \else
    {\sffamily\bfseries\color{criskAccent}#1}%
  \fi}

% [write]/[say] marks (shown only with the writesay option).
\definecolor{criskWrite}{HTML}{C0610F}
\definecolor{criskSay}{HTML}{1E7A44}
\def\crisk@w{write}
\def\crisk@s{say}
\newcommand*{\crisk@modetag}{%
  {\sffamily\bfseries\scriptsize
   \ifx\crisk@mode\crisk@w\color{criskWrite}WRITE\else
   \ifx\crisk@mode\crisk@s\color{criskSay}SAY\fi\fi}}

% Find write or say in a clue's options (e.g. "doubledown, write").
\newcommand{\crisk@findmode}[1]{%
  \def\crisk@mode{}%
  \edef\crisk@opts{\zap@space#1 \@empty}%
  \@for\crisk@opt:=\crisk@opts\do{%
    \ifx\crisk@opt\crisk@w\let\crisk@mode\crisk@w\fi
    \ifx\crisk@opt\crisk@s\let\crisk@mode\crisk@s\fi}}

% Tighter display spacing inside entries.
\newcommand{\crisk@displayskips}{%
  \setlength{\abovedisplayskip}{6pt plus 2pt minus 2pt}%
  \setlength{\belowdisplayskip}{6pt plus 2pt minus 2pt}%
  \setlength{\abovedisplayshortskip}{2pt plus 2pt}%
  \setlength{\belowdisplayshortskip}{6pt plus 2pt minus 2pt}}

% When a clue starts with \[ ... \], set that formula centered on the same
% line as the value (in display style) instead of leaving an empty line
% beside the value.
\long\def\crisk@inlinedisplay\[#1\]{%
  \hspace*{\fill}$\displaystyle #1$\hspace*{\fill}\par}

% #1 clue, #2 response, #3 solution, #4 nonempty if there is a solution.
% (A solution is shown only in the solutions version.)
% Each clue is set in a minipage so it never separates from its answer
% across a page break. Fermat's Last Round instead starts right after its
% heading, on the same page when the clue and response fit there, and a
% long worked solution may continue onto the next page.
\newcommand{\crisk@entry}[4]{%
  \def\crisk@hassolution{#4}%
  \par\addvspace{\ifcrisk@key 14pt\else 10pt\fi}%
  \ifcrisk@final
    \begingroup\tcbset{crisk@answerextra/.style={breakable}}%
  \else
    \noindent\begin{minipage}{\linewidth}%
  \fi
  \crisk@auxwrite
  \crisk@displayskips
  \begin{list}{}{%
    \setlength{\leftmargin}{3.4em}%
    \setlength{\labelwidth}{2.8em}%
    \setlength{\labelsep}{0.6em}%
    \setlength{\topsep}{0pt}%
    \setlength{\partopsep}{0pt}%
    \setlength{\itemsep}{0pt}%
    \setlength{\parsep}{4pt}}%
  \item[\crisk@makevalue{\crisk@valuetext}]%
    \begingroup
    \crisk@checkdisplay
    #1\par
    \endgroup
    \ifcrisk@key
      \ifcrisk@solutions\else\def\crisk@hassolution{}\fi
      \expandafter\crisk@ifblank\expandafter{\crisk@hassolution}%
        {\begin{crisk@answer}\crisk@label{RESPONSE}\crisk@afterlabel #2\end{crisk@answer}}%
        {\begin{crisk@answer}\crisk@label{RESPONSE}\crisk@afterlabel #2%
          \tcblower\crisk@label{SOLUTION}\crisk@afterlabel #3\end{crisk@answer}}%
    \fi
  \end{list}%
  \ifcrisk@final\endgroup\else\end{minipage}\fi\par
}

\newcommand{\crisk@checkdisplay}{\@ifnextchar\[{\crisk@inlinedisplay}{}}

% After a RESPONSE or SOLUTION label: start a new line, unless a display
% comes next (then the display itself starts below the label).
\newcommand{\crisk@afterlabel}{\@ifnextchar\[{}{\par\nobreak}}

% The optional argument ([doubledown], [write], [say]) is not shown, except
% that write/say is shown with the writesay option.
\NewEnviron{clue}[1][]{%
  \stepcounter{criskclue}%
  \crisk@findmode{#1}%
  \edef\crisk@auxwrite{\noexpand\protected@write\noexpand\@auxout{}%
    {\string\crisk@auxrow{\thecriskclue}}}%
  \edef\crisk@valuetext{\the\numexpr100*\value{criskclue}\relax}%
  \expandafter\crisk@split\BODY\solution\solution\crisk@stop
}

%----------------------------------------------------------------------
% Fermat's Last Round

% The optional argument ([write], [say]) is shown only with writesay.
\NewEnviron{final}[2][]{%
  \crisk@findmode{#1}%
  \protected@write\@auxout{}{\string\crisk@auxfinal{\unexpanded{#2}}}%
  \crisk@heading{FERMAT'S LAST ROUND}{#2}%
  \crisk@finaltrue
  \let\crisk@auxwrite\relax
  \def\crisk@valuetext{}%
  \expandafter\crisk@split\BODY\solution\solution\crisk@stop
}

\endinput
